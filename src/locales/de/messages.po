msgstr "Leistung"

#. js-lingui-explicit-id
#: src/routes/first-start.tsx:256
msgid "first-start.step.phash.title"
msgstr "Hast du einen alten oder langsamen Computer? Dann solltest du Hintergrund-Hashing deaktivieren"

